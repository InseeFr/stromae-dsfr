{
  "name": "stromae-dsfr",
  "private": true,
  "version": "2.11.5",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "prepare": "husky && vite-envs update-types",
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint ./src",
    "preview": "vite preview",
    "_format": "prettier --ignore-unknown .",
    "format": "npm run _format -- --write",
    "format:check": "npm run _format -- --list-different",
    "predev": "react-dsfr optimize-css",
    "prebuild": "react-dsfr optimize-css",
    "generate-api-client": "orval --config ./orval.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "cross-env STORYBOOK=true storybook build",
    "prestorybook": "react-dsfr optimize-css",
    "prebuild-storybook": "react-dsfr optimize-css"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.35.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.14.1",
    "@inseefr/lunatic": "^3.13.5",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-router": "^1.134.12",
    "axios": "^1.20.0",
    "date-fns": "^4.1.0",
    "fast-deep-equal": "^3.1.3",
    "he": "^1.2.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "oidc-spa": "10.0.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.66.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.0",
    "react-number-format": "^5.4.4",
    "tsafe": "^1.8.12",
    "tss-react": "^4.9.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@eslint/js": "^10.0.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "10.6.5",
    "@storybook/blocks": "^8.6.12",
    "@storybook/builder-vite": "10.6.5",
    "@storybook/channels": "^8.6.12",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@storybook/test": "8.6.15",
    "@storybook/theming": "^8.6.12",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc-d48603a5-20240813",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "^9.1.6",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "orval": "8.46.0",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "storybook-dark-mode": "^5.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vite-envs": "^4.6.1",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --list-different"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": "prettier --write --ignore-unknown --list-different"
  }
}
